# Identity of the build. The release tag is ffmpeg-${FFMPEG_VERSION}-${BUILD}.
FFMPEG_VERSION=8.1.3
BUILD=1
# Oldest macOS the macOS binaries run on.
MACOS_DEPLOYMENT_TARGET=12.0
# Linux build image (multi-arch index digest): musl, so the binaries are fully static.
ALPINE_IMAGE=alpine:3.24@sha256:f59abe656b692d901e184be3445e084786602108599d2a51d229c0f5a48c71bf
