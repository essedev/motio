{
	"name": "@motiojs/compat",
	"version": "0.1.0",
	"description": "Bundler plugin mapping remotion and @remotion/* imports to Motio",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/essedev/motio.git",
		"directory": "packages/compat"
	},
	"homepage": "https://motio.esse.dev/reference/packages/compat/",
	"bugs": {
		"url": "https://github.com/essedev/motio/issues"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./config": {
			"types": "./dist/config/index.d.ts",
			"default": "./dist/config/index.js"
		},
		"./tailwind": {
			"types": "./dist/tailwind-v3-entry.d.ts",
			"default": "./dist/tailwind-v3-entry.js"
		},
		"./tailwind-v4": {
			"types": "./dist/tailwind-v4-entry.d.ts",
			"default": "./dist/tailwind-v4-entry.js"
		},
		"./manifest.json": "./manifest.json"
	},
	"files": [
		"dist",
		"manifest.json",
		"manifest.schema.json",
		"NOTICE"
	],
	"sideEffects": false,
	"scripts": {
		"manifest:status": "tsc -b && node scripts/manifest-status.mjs",
		"manifest:enumerate": "node scripts/enumerate-exports.mjs"
	},
	"dependencies": {
		"oxc-parser": "^0.159.0"
	},
	"devDependencies": {
		"ajv": "^8.20.0",
		"vite": "8.3.8"
	},
	"peerDependencies": {
		"vite": ">=8.0.0"
	},
	"engines": {
		"node": ">=22"
	},
	"publishConfig": {
		"access": "public"
	}
}
