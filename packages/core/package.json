{
	"name": "@motiojs/core",
	"version": "0.0.0",
	"description": "Timeline, hooks, components and animation primitives (browser)",
	"license": "Apache-2.0",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./no-react": {
			"types": "./dist/no-react.d.ts",
			"default": "./dist/no-react.js"
		},
		"./protocol": {
			"types": "./dist/protocol.d.ts",
			"default": "./dist/protocol.js"
		},
		"./runtime": {
			"types": "./dist/runtime/index.d.ts",
			"default": "./dist/runtime/index.js"
		},
		"./clock-shim": {
			"types": "./dist/clock-shim.d.ts",
			"default": "./dist/clock-shim.js"
		},
		"./frame-gate": {
			"types": "./dist/frame-gate.d.ts",
			"default": "./dist/frame-gate.js"
		},
		"./internals": {
			"types": "./dist/internals.d.ts",
			"default": "./dist/internals.js"
		},
		"./version": {
			"types": "./dist/version.d.ts",
			"default": "./dist/version.js"
		},
		"./config": {
			"types": "./dist/project-config.d.ts",
			"default": "./dist/project-config.js"
		}
	},
	"files": [
		"dist"
	],
	"sideEffects": false,
	"scripts": {},
	"devDependencies": {
		"@motiojs/testing": "workspace:*",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"jsdom": "^31.0.1",
		"react": "19.3.1",
		"react-dom": "19.3.1"
	},
	"peerDependencies": {
		"react": "^18.0.0 || ^19.0.0",
		"react-dom": "^18.0.0 || ^19.0.0"
	}
}
