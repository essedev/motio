{
	"$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
	"root": false,
	"extends": "//",
	"files": {
		"includes": ["**", "!src/__oracle__/*.json"]
	},
	"overrides": [
		{
			"includes": ["src/**/*.test.tsx", "src/testing/**"],
			"linter": {
				"rules": {
					"correctness": {
						"noComponentHookFactories": "off"
					},
					"complexity": {
						"noUselessFragments": "off"
					}
				}
			}
		}
	]
}
