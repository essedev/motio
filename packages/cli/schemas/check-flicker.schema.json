{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "urn:motio:cli:check-flicker",
	"title": "motio check flicker --json",
	"description": "Frames that differ from both neighbours. Exit code 3 when any is flagged.",
	"oneOf": [
		{
			"type": "object",
			"additionalProperties": false,
			"required": [
				"ok",
				"command",
				"composition",
				"frames",
				"threshold",
				"clean",
				"flagged",
				"warnings"
			],
			"properties": {
				"ok": {
					"const": true
				},
				"command": {
					"const": "check flicker"
				},
				"composition": {
					"$ref": "urn:motio:cli:common#/$defs/composition"
				},
				"frames": {
					"type": "integer",
					"minimum": 1
				},
				"threshold": {
					"type": "number",
					"exclusiveMinimum": 0,
					"exclusiveMaximum": 1
				},
				"clean": {
					"type": "boolean"
				},
				"flagged": {
					"type": "array",
					"items": {
						"type": "object",
						"required": ["frame", "diffPrevious", "diffNext", "diffNeighbours"],
						"additionalProperties": false,
						"properties": {
							"frame": {
								"type": "integer"
							},
							"diffPrevious": {
								"type": "number"
							},
							"diffNext": {
								"type": "number"
							},
							"diffNeighbours": {
								"type": "number"
							},
							"blocks": {
								"type": "object",
								"description": "Set when blocks of 16 px jumped away from both neighbours on their own: a small element shown for one frame.",
								"required": ["blocks", "region", "maxDiff"],
								"additionalProperties": false,
								"properties": {
									"blocks": {
										"type": "integer",
										"minimum": 1
									},
									"region": {
										"type": "object",
										"description": "Bounding box of the blocks, in captured pixels.",
										"required": ["x", "y", "width", "height"],
										"additionalProperties": false,
										"properties": {
											"x": {
												"type": "integer"
											},
											"y": {
												"type": "integer"
											},
											"width": {
												"type": "integer"
											},
											"height": {
												"type": "integer"
											}
										}
									},
									"maxDiff": {
										"type": "number",
										"description": "Largest difference of a block from its neighbours, 0 to 1."
									}
								}
							}
						}
					}
				},
				"warnings": {
					"$ref": "urn:motio:cli:common#/$defs/warnings"
				},
				"renderWarnings": {
					"$ref": "urn:motio:cli:common#/$defs/renderWarnings"
				}
			}
		},
		{
			"$ref": "urn:motio:cli:common#/$defs/error"
		}
	]
}
