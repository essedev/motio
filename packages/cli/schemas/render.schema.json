{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "urn:motio:cli:render",
	"title": "motio render --json",
	"description": "Result of rendering a video.",
	"oneOf": [
		{
			"type": "object",
			"additionalProperties": false,
			"required": [
				"ok",
				"command",
				"composition",
				"output",
				"codec",
				"renderedFrames",
				"durationMs",
				"serveUrl",
				"warnings"
			],
			"properties": {
				"ok": {
					"const": true
				},
				"command": {
					"const": "render"
				},
				"composition": {
					"$ref": "urn:motio:cli:common#/$defs/composition"
				},
				"output": {
					"type": "string",
					"description": "Absolute path: the file, or the folder of an image sequence."
				},
				"codec": {
					"type": ["string", "null"],
					"description": "The codec, or null for an image sequence."
				},
				"renderedFrames": {
					"type": "integer",
					"minimum": 0
				},
				"durationMs": {
					"type": "integer",
					"minimum": 0
				},
				"serveUrl": {
					"type": "string"
				},
				"ffmpeg": {
					"type": "object",
					"description": "The FFmpeg that encoded the video (D-065). Absent for image sequences, which do not run FFmpeg.",
					"additionalProperties": false,
					"required": ["path", "version", "source"],
					"properties": {
						"path": {
							"type": "string"
						},
						"version": {
							"type": ["string", "null"],
							"description": "As FFmpeg prints it; null when it could not be read."
						},
						"source": {
							"enum": ["option", "env", "package", "path"],
							"description": "MOTIO_FFMPEG (env), the pinned build of @motiojs/ffmpeg (package) or PATH."
						},
						"build": {
							"type": "integer",
							"description": "Build number of the pinned build, when source is package."
						}
					}
				},
				"warnings": {
					"$ref": "urn:motio:cli:common#/$defs/warnings"
				},
				"sequence": {
					"const": true,
					"description": "Present when the output is an image sequence folder."
				},
				"imageFormat": {
					"enum": ["jpeg", "png"],
					"description": "Image format of an image sequence."
				}
			}
		},
		{
			"$ref": "urn:motio:cli:common#/$defs/error"
		}
	]
}
