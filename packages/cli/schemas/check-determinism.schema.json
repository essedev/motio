{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "urn:motio:cli:check-determinism",
	"title": "motio check determinism --json",
	"description": "Decoded frame hashes compared across render orders and concurrencies. Exit code 3 when frames differ.",
	"oneOf": [
		{
			"type": "object",
			"additionalProperties": false,
			"required": [
				"ok",
				"command",
				"composition",
				"frames",
				"runs",
				"deterministic",
				"mismatches",
				"warnings"
			],
			"properties": {
				"ok": {
					"const": true
				},
				"command": {
					"const": "check determinism"
				},
				"composition": {
					"$ref": "urn:motio:cli:common#/$defs/composition"
				},
				"frames": {
					"type": "array",
					"items": {
						"type": "integer",
						"minimum": 0
					},
					"minItems": 1
				},
				"reference": {
					"description": "What every run is compared with: the first run (runs) or a render with a new page per frame (fresh, the first run). Absent in results of older versions, which mean runs.",
					"enum": ["runs", "fresh"]
				},
				"runs": {
					"type": "array",
					"items": {
						"type": "object",
						"required": ["order", "concurrency"],
						"additionalProperties": false,
						"properties": {
							"order": {
								"enum": ["ascending", "descending"]
							},
							"concurrency": {
								"type": ["integer", "string"]
							},
							"freshPage": {
								"description": "Every frame of this run was rendered on a new page.",
								"const": true
							}
						}
					}
				},
				"deterministic": {
					"type": "boolean"
				},
				"mismatches": {
					"type": "array",
					"items": {
						"type": "object",
						"required": ["frame", "hashes"],
						"additionalProperties": false,
						"properties": {
							"frame": {
								"type": "integer"
							},
							"hashes": {
								"type": "array",
								"items": {
									"type": "string"
								}
							}
						}
					}
				},
				"warnings": {
					"$ref": "urn:motio:cli:common#/$defs/warnings"
				},
				"renderWarnings": {
					"$ref": "urn:motio:cli:common#/$defs/renderWarnings"
				}
			}
		},
		{
			"$ref": "urn:motio:cli:common#/$defs/error"
		}
	]
}
