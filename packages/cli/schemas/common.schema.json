{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "urn:motio:cli:common",
	"$defs": {
		"warnings": {
			"type": "array",
			"items": {
				"type": "string"
			},
			"description": "Warnings printed during the command (config, bundler, compat)."
		},
		"renderWarnings": {
			"type": "array",
			"description": "Warnings the page raised while rendering (a fallback font, Math.random, a slow delayRender...), deduplicated. Their messages are also in warnings. Present only when there is at least one.",
			"items": {
				"type": "object",
				"required": ["code", "message"],
				"additionalProperties": true,
				"properties": {
					"code": {
						"type": "string",
						"pattern": "^W_[A-Z0-9_]+$"
					},
					"message": {
						"type": "string"
					},
					"frame": {
						"type": "integer",
						"minimum": 0,
						"description": "The frame it was first seen on, when it belongs to one."
					}
				}
			}
		},
		"composition": {
			"type": "object",
			"required": ["id", "width", "height", "fps", "durationInFrames"],
			"additionalProperties": false,
			"properties": {
				"id": {
					"type": "string"
				},
				"width": {
					"type": "integer",
					"minimum": 1
				},
				"height": {
					"type": "integer",
					"minimum": 1
				},
				"fps": {
					"type": "number",
					"exclusiveMinimum": 0
				},
				"durationInFrames": {
					"type": "integer",
					"minimum": 1
				}
			}
		},
		"error": {
			"type": "object",
			"required": ["ok", "command", "error"],
			"additionalProperties": false,
			"properties": {
				"ok": {
					"const": false
				},
				"command": {
					"type": ["string", "null"]
				},
				"error": {
					"type": "object",
					"required": ["code", "message", "context"],
					"additionalProperties": false,
					"properties": {
						"code": {
							"type": "string",
							"pattern": "^E_[A-Z0-9_]+$",
							"description": "Stable error code."
						},
						"message": {
							"type": "string"
						},
						"context": {
							"type": "object",
							"description": "Structured details: flag, frame, label, composition, path..."
						}
					}
				}
			}
		}
	}
}
