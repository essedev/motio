{
	"name": "@motiojs/cli",
	"version": "0.1.0",
	"description": "The motio command line",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/essedev/motio.git",
		"directory": "packages/cli"
	},
	"homepage": "https://motio.esse.dev/reference/packages/cli/",
	"bugs": {
		"url": "https://github.com/essedev/motio/issues"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./schemas/*": "./schemas/*"
	},
	"files": [
		"dist",
		"schemas",
		"starters",
		"NOTICE"
	],
	"sideEffects": false,
	"scripts": {},
	"devDependencies": {
		"@motiojs/motio": "workspace:*",
		"@motiojs/testing": "workspace:*",
		"ajv": "^8.20.0",
		"puppeteer-core": "25.18.1",
		"react": "19.3.1",
		"react-dom": "19.3.1"
	},
	"bin": {
		"motio": "./dist/bin.js"
	},
	"engines": {
		"node": ">=22"
	},
	"dependencies": {
		"@motiojs/bundler": "workspace:*",
		"@motiojs/compat": "workspace:*",
		"@motiojs/distributed": "workspace:*",
		"@motiojs/renderer": "workspace:*"
	},
	"publishConfig": {
		"access": "public"
	}
}
