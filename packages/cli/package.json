{
	"name": "@motiojs/cli",
	"version": "0.0.0",
	"description": "The motio command line",
	"license": "Apache-2.0",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./schemas/*": "./schemas/*"
	},
	"files": [
		"dist",
		"schemas",
		"starters"
	],
	"sideEffects": false,
	"scripts": {},
	"devDependencies": {
		"@motiojs/motio": "workspace:*",
		"@motiojs/testing": "workspace:*",
		"ajv": "^8.20.0",
		"puppeteer-core": "25.18.1",
		"react": "19.3.1",
		"react-dom": "19.3.1"
	},
	"bin": {
		"motio": "./dist/bin.js"
	},
	"engines": {
		"node": ">=22"
	},
	"dependencies": {
		"@motiojs/bundler": "workspace:*",
		"@motiojs/compat": "workspace:*",
		"@motiojs/distributed": "workspace:*",
		"@motiojs/renderer": "workspace:*"
	}
}
