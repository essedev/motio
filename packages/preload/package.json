{
	"name": "@motiojs/preload",
	"version": "0.1.0",
	"description": "Preload videos, audio, images and fonts so a Motio Player shows them without loading, mirroring @remotion/preload",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/essedev/motio.git",
		"directory": "packages/preload"
	},
	"homepage": "https://motio.esse.dev/reference/packages/preload/",
	"bugs": {
		"url": "https://github.com/essedev/motio/issues"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"NOTICE"
	],
	"sideEffects": false,
	"scripts": {},
	"devDependencies": {
		"esbuild": "0.28.1",
		"jsdom": "^31.0.1",
		"puppeteer-core": "25.18.1"
