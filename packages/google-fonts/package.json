{
	"name": "@motiojs/google-fonts",
	"version": "0.1.0",
	"description": "Type-safe Google Fonts loading for Motio. Compatible with the @remotion/google-fonts API",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/essedev/motio.git",
		"directory": "packages/google-fonts"
	},
	"homepage": "https://motio.esse.dev/reference/packages/google-fonts/",
	"bugs": {
		"url": "https://github.com/essedev/motio/issues"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./*": {
			"types": "./dist/fonts/*.d.ts",
			"default": "./dist/fonts/*.js"
		}
	},
	"files": [
		"dist",
		"NOTICE"
	],
	"sideEffects": false,
	"scripts": {
		"generate": "node scripts/generate.ts"
	},
	"dependencies": {
		"@motiojs/core": "workspace:*"
	},
	"publishConfig": {
		"access": "public"
	}
}
