{
	"name": "motio",
	"version": "0.0.0",
	"description": "Make videos with React. Remotion-compatible API, Apache-2.0",
	"license": "Apache-2.0",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./version": {
			"types": "./dist/version.d.ts",
			"default": "./dist/version.js"
		},
		"./no-react": {
			"types": "./dist/no-react.d.ts",
			"default": "./dist/no-react.js"
		},
		"./remotion": {
			"types": "./dist/remotion.d.ts",
			"default": "./dist/remotion.js"
		},
		"./remotion/version": {
			"types": "./dist/remotion/version.d.ts",
			"default": "./dist/remotion/version.js"
		},
		"./remotion/no-react": {
			"types": "./dist/remotion/no-react.d.ts",
			"default": "./dist/remotion/no-react.js"
		},
		"./client": {
			"types": "./client.d.ts"
		}
	},
	"files": [
		"dist",
		"client.d.ts"
	],
	"sideEffects": false,
	"scripts": {},
	"dependencies": {
		"@motiojs/core": "workspace:*",
		"@motiojs/media": "workspace:*"
	},
	"devDependencies": {
		"@motiojs/bundler": "workspace:*",
		"@motiojs/renderer": "workspace:*",
		"@motiojs/testing": "workspace:*",
		"@types/node": "^26.6.6",
		"@types/react": "19.3.0",
		"react": "19.3.1",
		"react-dom": "19.3.1"
	},
	"peerDependencies": {
		"react": "^18.0.0 || ^19.0.0",
		"react-dom": "^18.0.0 || ^19.0.0"
	}
}
