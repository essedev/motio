{
	"name": "@motiojs/renderer",
	"version": "0.0.0",
	"description": "Node renderer: headless Chrome capture and FFmpeg encoding",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/essedev/motio.git",
		"directory": "packages/renderer"
	},
	"homepage": "https://motio.esse.dev/reference/packages/renderer/",
	"bugs": {
		"url": "https://github.com/essedev/motio/issues"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./client": {
			"types": "./dist/client.d.ts",
			"default": "./dist/client.js"
		}
	},
	"files": [
		"dist",
		"NOTICE"
	],
	"sideEffects": false,
	"scripts": {},
	"dependencies": {
		"@motiojs/audio": "workspace:*",
		"@motiojs/core": "workspace:*",
		"@motiojs/video-frames": "workspace:*",
		"@puppeteer/browsers": "^3.2.7",
		"puppeteer-core": "^25.18.1"
	},
	"devDependencies": {
		"@motiojs/testing": "workspace:*"
	},
	"engines": {
		"node": ">=22"
	},
	"publishConfig": {
		"access": "public"
	}
}
