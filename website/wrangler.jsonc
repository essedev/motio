// Deploys the built site (dist/) as static assets on Cloudflare: `make site-build`, then
// `pnpm dlx wrangler deploy` from this directory.
{
	"name": "motio-site",
	"compatibility_date": "2026-11-01",
	"assets": {
		"directory": "./dist",
		"not_found_handling": "404-page",
		"html_handling": "auto-trailing-slash"
	},
	"routes": [{ "pattern": "motio.esse.dev", "custom_domain": true }],
	"workers_dev": false
}
